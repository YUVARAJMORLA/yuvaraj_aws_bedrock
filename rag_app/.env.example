# AWS Configuration
# You can set these or use `aws configure` in AWS CLI
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=your_session_token_if_temporary

# Model Configurations (Optional overrides)
# Llama model ID or Bedrock inference profile
LLAMA_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0
# LLAMA_MODEL_ID=arn:aws:bedrock:us-east-1:YOUR_ACCOUNT_ID:inference-profile/us.meta.llama4-maverick-17b-instruct-v1:0
